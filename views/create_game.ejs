    <title>Crear joc</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1>Crear joc</h1>
    <form action="/games" method="POST">
        <label for="title">Títol:</label>
        <input type="text" id="title" name="title" required>

        <label for="author">Autor:</label>

<!DOCTYPE html>
<html lang="ca">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edita jocs</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header>
        <h1>Editar joc: <%= game.title %></h1>
    </header>
    <main>
        <form action="/games/<%= game.id %>?_method=PUT" method="POST">
            <label for="title">Nom:</label>
            <input type="text" id="title" name="title" value="<%= game.title %>" required>
            
            <label for="year">Any:</label>
            <input type="number" id="year" name="year" value="<%= game.year %>" required>

            <label for="author">Autor:</label>
            <input type="text" id="author" name="author" value="<%= game.author %>" required>

            <button type="submit">Desar Canvis</button>
        </form>
        <a href="/games">Tornar al llistat</a>
    </main>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Benvingut</title>
    <link rel="stylesheet" type="text/css" href="/styles.css">
</head>
<body >
    <header>
        <h1>Gestió de Productes per <%= user.name %>!</h1>
    </header>
    <main class="hover">
        <section class="an">
            <h2>Llista de productes</h2>
            <ul class="product-list">
                <% data.products.forEach(p => { %>
                    <li class="product-item">
                        <strong><%= p.name %></strong>
                        <span>Categoria: <%= p.author %></span>
                        <span>Preu: <%= p.year %>€</span>
                    </li>
                <% }) %>
            </ul>
        </section>
        <form id="createForm">
            <h2>Crea un producte</h2>
            <label for="name">Nom</label>
            <input type="text" id="name" placeholder="Samarreta negra">
            <label for="category">Categoria</label>
            <input type="text" id="category" placeholder="Roba">
            <label for="price">Preu</label>
            <input type="number" id="price" placeholder="5.99">
            <button type="submit">Crear</button>
        </form>
    </main>
</body>
</html>